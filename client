#!/usr/bin/env python3
"""CS 4700 Project 1 Wordle client.

The program speaks the newline-delimited JSON protocol from the assignment,
supports plain TCP and TLS sockets, and chooses guesses from the official word
list.  The word list is fetched into memory from the course URL at runtime; no
files are written.
"""

from __future__ import annotations

import json
import socket
import ssl
import sys
import urllib.request
from collections import Counter
from dataclasses import dataclass
from typing import Any

